{
 "configs": {
  "envoy": "admin:\n  address: {socket_address: {address: 127.0.0.1, port_value: 9901}}\nstatic_resources:\n  listeners:\n  - name: l\n    address: {socket_address: {address: 127.0.0.1, port_value: 8080}}\n    filter_chains:\n    - filters:\n      - name: envoy.filters.network.http_connection_manager\n        typed_config:\n          \"@type\": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager\n          stat_prefix: ingress\n          route_config:\n            name: r\n            virtual_hosts:\n            - name: all\n              domains: [\"*\"]\n              routes:\n              - match: {prefix: \"/\"}\n                route:\n                  cluster: be\n                  retry_policy:\n                    retry_on: connect-failure,refused-stream\n                    num_retries: 2\n          http_filters:\n          - name: envoy.filters.http.router\n            typed_config:\n              \"@type\": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router\n  clusters:\n  - name: be\n    type: STATIC\n    connect_timeout: 0.5s\n    lb_policy: ROUND_ROBIN\n    health_checks:\n    - timeout: 0.3s\n      interval: 0.3s\n      no_traffic_interval: 0.3s\n      unhealthy_threshold: 2\n      healthy_threshold: 2\n      http_health_check: {path: /healthz}\n    outlier_detection:\n      consecutive_5xx: 3\n      interval: 0.3s\n      base_ejection_time: 3s\n      max_ejection_percent: 50\n    load_assignment:\n      cluster_name: be\n      endpoints:\n      - lb_endpoints:\n        - endpoint: {address: {socket_address: {address: 127.0.0.1, port_value: 9001}}}\n        - endpoint: {address: {socket_address: {address: 127.0.0.1, port_value: 9002}}}\n        - endpoint: {address: {socket_address: {address: 127.0.0.1, port_value: 9003}}}\n",
  "haproxy": "global\n  stats socket /tmp/admin.sock mode 600 level admin\n  maxconn 4096\n\ndefaults\n  mode http\n  timeout connect 500ms\n  timeout client 10s\n  timeout server 10s\n  timeout queue 1000ms\n  retries 2\n  option redispatch\n\nfrontend fe\n  bind 127.0.0.1:8080\n  default_backend be\n\nbackend be\n  balance roundrobin\n  option httpchk\n  http-check send meth GET uri /healthz\n  default-server inter 300ms fall 2 rise 2 observe layer7 error-limit 3 on-error mark-down\n  server b0 127.0.0.1:9001 check\n  server b1 127.0.0.1:9002 check\n  server b2 127.0.0.1:9003 check\n"
